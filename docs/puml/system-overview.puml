@startuml system-overview
!theme plain
skinparam defaultFontName "Noto Sans JP"
skinparam linetype ortho
skinparam rectangle {
  BackgroundColor white
  BorderColor #333333
}
skinparam database {
  BackgroundColor #e8f4fd
  BorderColor #333333
}

title AI Desktop Agent - システム構成

actor "ユーザー\n(ブラウザ)" as user

rectangle "Docker ホスト" {
  rectangle "frontend\nNext.js :3000" as fe
  rectangle "backend\nFastAPI :8081" as be
  rectangle "websockify-desktop\nVNC→WS :6081" as wsd
  rectangle "desktop\n軽量デスクトップ :5901\nXfce+TigerVNC (既定)" as desk
  rectangle "websockify\nVNC→WS :6080\n(kvm限定)" as ws
  rectangle "vm\nQEMU/KVM :5900 (kvm限定)\nKDE / 4vCPU・4GB" as vm
  rectangle "vm-<id> / desk-<id>\n動的払い出し :5910+/:6090+" as vm2
  database "data/\ntasks/*.json\nvms.json" as data
  rectangle "Docker\nデーモン" as docker
}

user --> fe : 指示・視聴\nHTTP :3000
fe --> be : REST / WS\n:8081
user --> wsd : 画面配信 WS\n:6081 (既定)
user --> ws : 画面配信 WS\n:6080 (KVM時のみ)
wsd --> desk : VNC中継\ndesktop:5900
ws --> vm : VNC中継\nvm:5900
be --> desk : VNC操作 (既定)\ndesktop:5900
be --> vm : VNC操作 (KVM時)\nvm:5900 (動的はvm-<id>:5900)
be --> data : 履歴保存\ndata/tasks/*.json
be --> docker : 環境管理\nDocker socket
docker --> vm2 : コンテナ払い出し\nqcow2フルコピー (cp --sparse)\n動的コンテナはKVM不要
@enduml
