# AI Desktop Agent — 環境変数設定
# .env.example を .env にコピーして API キーを設定してください

# ── LLM プロバイダ ───────────────────────────────────
# 以下のいずれか 1 つを設定

# OpenAI（推奨）
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here

# OpenRouter（マルチプロバイダ、安価）
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenCode Zen（OpenAI互換ゲートウェイ、安価）
# https://opencode.ai/zen でAPIキーを取得
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=your-key-here
# LLM_MODEL=deepseek-v4.1-flash

# OpenCode Go（月額サブスク、openモデル特化）
# https://opencode.ai のコンソールでGo/Go Plusを契約しAPIキーを取得
# LLM_PROVIDER=opencode-go
# OPENCODE_GO_API_KEY=your-key-here
# LLM_MODEL=deepseek-v4.1-flash

# ── モデル ───────────────────────────────────────────
# 省略可。デフォルトはプロバイダごとに設定済み
# LLM_MODEL=gpt-4o

# ── 実行環境 ─────────────────────────────────────────
# KVM利用は自動判定のため、通常は設定不要。
# - KVM（/dev/kvm）があるホスト: ./scripts/up.sh が vm を自動起動
# - ないホスト: 軽量コンテナ環境（desktop）のみ起動。VM起動は制限される
#
# 任意の上書き（通常は不要）:
# USE_KVM=true   # KVMを必須にする（/dev/kvm がなければVMは起動失敗する）
# USE_KVM=false  # TCG扱いにする（VM起動は制限される）
# ALLOW_TCG_VM=true  # デバッグ目的でTCG実行を明示許可する
